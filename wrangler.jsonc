{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "finisher",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-09-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "finisher-db",
			"database_id": "08d1d7e0-e1aa-41ff-99cb-c03c59fc85bb",
			"migrations_dir": "migrations"
		}
	]
}