# next dev reads .env.local. Workers use .dev.vars locally / wrangler secret put remotely.
# Generate with openssl rand -base64 32; never commit the generated value.
AUTH_SECRET=
# Your canonical hosted HTTPS origin; local web development may use http://localhost:3000.
AUTH_URL=
# Auth.js host trust; only deploy behind a trusted host/proxy.
AUTH_TRUST_HOST=true
# Google Cloud Console > OAuth Web client; callback http://localhost:3000/api/auth/callback/google.
AUTH_GOOGLE_ID=
# Secret for that Google OAuth Web client.
AUTH_GOOGLE_SECRET=
# Apple Developer > Identifiers > Services ID; callback https://<host>/api/auth/callback/apple.
AUTH_APPLE_ID=
# Optional prebuilt Apple client-secret JWT; otherwise supply the trio below.
AUTH_APPLE_SECRET=
# Apple Developer membership Team ID.
APPLE_TEAM_ID=
# Apple Developer > Keys > Sign in with Apple > Key ID.
APPLE_KEY_ID=
# Download that key's .p8 once; PEM accepts escaped newline sequences.
APPLE_PRIVATE_KEY=
# Hosted HTTPS auth origin; export this variable in the shell before build:ios (staging excludes env files).
# Leave empty for same-origin web.
NEXT_PUBLIC_AUTH_ORIGIN=
# Cloudflare dashboard account ID (Wrangler CLI only).
CLOUDFLARE_ACCOUNT_ID=
# From wrangler d1 create finisher-db; also replace database_id in wrangler.jsonc.
CLOUDFLARE_DATABASE_ID=
